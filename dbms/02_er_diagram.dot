digraph velora_er {
    graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.55", ranksep="1.3",
           fontname="Helvetica", label="Velora ER diagram", labelloc="t", fontsize=18];
    node [shape=record, fontname="Helvetica", fontsize=9, color="#9fb0c4", penwidth=1.1];
    edge [fontname="Helvetica", fontsize=8, color="#5b6779", penwidth=1.1, arrowhead=crow];

    Medicine [label="{Medicine|id : int (PK)\lname : text (UK)\lform : text\l}"];
    Pharmacy [label="{Pharmacy|id : int (PK)\lname : text\larea : text\laddress : text\lphone : text\licenceNumber : text (UK)\lstatus : text\l distanceKm : float\l ownerId : int (UK, FK)\l}"];
    StockItem [label="{StockItem|id : int (PK)\lpharmacyId : int (FK)\lmedicineId : int (FK)\lquantity : int\lpricePaise : int\lcreatedAt : timestamp\lupdatedAt : timestamp\l}"];
    User [label="{User|id : int (PK)\lname : text\lphone : text (UK)\laddress : text\lpasswordHash : text\lrole : text\lmfaSecret : text\lmfaEnabled : bool\lcreatedAt : timestamp\l}"];
    Hold [label="{Hold|id : int (PK)\luserId : int (FK)\lstockItemId : int (FK)\lquantity : int\lstatus : text\lexpiresAt : timestamp\lcreatedAt : timestamp\l}"];
    RefreshToken [label="{RefreshToken|id : int (PK)\luserId : int (FK)\ltokenHash : text (UK)\lfamilyId : text\lexpiresAt : timestamp\lrevokedAt : timestamp\lreplacedByHash : text\lcreatedAt : timestamp\l}"];
    AuditLog [label="{AuditLog|id : int (PK)\lactorId : int (FK, null)\laction : text\lentity : text\lentityId : text\lmetadata : text\lcreatedAt : timestamp\l}"];
    OAuthClient [label="{OAuthClient|id : int (PK)\lname : text\lclientId : text (UK)\lclientSecretHash : text\lredirectUris : text\lscopes : text\lcreatedAt : timestamp\l}"];
    AuthorizationCode [label="{AuthorizationCode|id : int (PK)\lcodeHash : text (UK)\lclientId : int (FK)\luserId : int (FK)\lscopes : text\lredirectUri : text\lcodeChallenge : text\lcodeChallengeMethod : text\lexpiresAt : timestamp\lusedAt : timestamp\lcreatedAt : timestamp\l}"];
    OAuthRefreshToken [label="{OAuthRefreshToken|id : int (PK)\ltokenHash : text (UK)\lclientId : int (FK)\luserId : int (FK)\lscopes : text\lexpiresAt : timestamp\lrevokedAt : timestamp\lcreatedAt : timestamp\l}"];

    Pharmacy -> StockItem [label="1 : N"];
    Medicine -> StockItem [label="1 : N"];
    User -> Hold [label="1 : N"];
    StockItem -> Hold [label="1 : N"];
    User -> Pharmacy [label="0..1 : 1 (owner)"];
    User -> RefreshToken [label="1 : N"];
    User -> AuditLog [label="1 : N (actor)"];
    OAuthClient -> AuthorizationCode [label="1 : N"];
    User -> AuthorizationCode [label="1 : N"];
    OAuthClient -> OAuthRefreshToken [label="1 : N"];
    User -> OAuthRefreshToken [label="1 : N"];
}
