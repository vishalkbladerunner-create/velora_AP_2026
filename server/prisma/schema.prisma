// Prisma schema for the Velora API.
// Three models: a Medicine, a Pharmacy, and the StockItem that links them.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A medicine that pharmacies can stock, e.g. "Dolo 650" as a "TABLET".
model Medicine {
  id    Int         @id @default(autoincrement())
  name  String      @unique
  form  String
  stock StockItem[]
}

// A pharmacy. It starts as PENDING; only VERIFIED ones are shown in search.
model Pharmacy {
  id            Int         @id @default(autoincrement())
  name          String
  area          String
  address       String
  phone         String
  licenceNumber String      @unique
  status        String      @default("PENDING")
  stock         StockItem[]
}

// How many units of one medicine one pharmacy has, and the price in paise.
model StockItem {
  id         Int      @id @default(autoincrement())
  pharmacyId Int
  medicineId Int
  quantity   Int      @default(0)
  pricePaise Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id])
  medicine   Medicine @relation(fields: [medicineId], references: [id])

  @@unique([pharmacyId, medicineId])
}
