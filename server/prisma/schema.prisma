// Prisma schema for the Velora API.
// Five models: a Medicine, a Pharmacy, the StockItem that links them, a User,
// and the Hold that reserves stock for 30 minutes.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A medicine that pharmacies can stock, e.g. "Dolo 650" as a "TABLET".
model Medicine {
  id    Int         @id @default(autoincrement())
  name  String      @unique
  form  String
  stock StockItem[]
}

// A pharmacy. It starts as PENDING; only VERIFIED ones are shown in search.
model Pharmacy {
  id            Int         @id @default(autoincrement())
  name          String
  area          String
  address       String
  phone         String
  licenceNumber String      @unique
  status        String      @default("PENDING")
  distanceKm    Float       @default(2.5)
  ownerId       Int?        @unique
  owner         User?       @relation(fields: [ownerId], references: [id])
  stock         StockItem[]
}

// How many units of one medicine one pharmacy has, and the price in paise.
model StockItem {
  id         Int      @id @default(autoincrement())
  pharmacyId Int
  medicineId Int
  quantity   Int      @default(0)
  pricePaise Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id])
  medicine   Medicine @relation(fields: [medicineId], references: [id])
  holds      Hold[]

  @@unique([pharmacyId, medicineId])
}

// A Velora account. The password is stored only as a bcrypt hash.
model User {
  id           Int       @id @default(autoincrement())
  name         String
  phone        String    @unique
  address      String?
  passwordHash String
  accountType  String    @default("CUSTOMER")
  createdAt    DateTime  @default(now())
  holds        Hold[]
  pharmacy     Pharmacy?
}

// A 30-minute reservation against one stock row.
model Hold {
  id          Int       @id @default(autoincrement())
  userId      Int
  stockItemId Int
  quantity    Int
  status      String    @default("ACTIVE")
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])
}
