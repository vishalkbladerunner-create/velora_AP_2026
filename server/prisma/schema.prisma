// Prisma schema for the Velora API.
// Medicines, pharmacies and the stock that links them; accounts, refresh
// tokens, 30-minute holds, an audit trail, and the OAuth/OIDC clients used by
// partner integrations.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A medicine that pharmacies can stock, e.g. "Dolo 650" as a "TABLET".
model Medicine {
  id    Int         @id @default(autoincrement())
  name  String      @unique
  form  String
  stock StockItem[]
}

// A pharmacy. It starts as PENDING; only VERIFIED ones are shown in search.
model Pharmacy {
  id            Int         @id @default(autoincrement())
  name          String
  area          String
  address       String
  phone         String
  licenceNumber String      @unique
  status        String      @default("PENDING")
  distanceKm    Float       @default(2.5)
  ownerId       Int?        @unique
  owner         User?       @relation(fields: [ownerId], references: [id])
  stock         StockItem[]
}

// How many units of one medicine one pharmacy has, and the price in paise.
model StockItem {
  id         Int      @id @default(autoincrement())
  pharmacyId Int
  medicineId Int
  quantity   Int      @default(0)
  pricePaise Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id])
  medicine   Medicine @relation(fields: [medicineId], references: [id])
  holds      Hold[]

  @@unique([pharmacyId, medicineId])
}

// A Velora account. The password is stored only as a bcrypt hash.
// role is CUSTOMER, PHARMACY or ADMIN and drives the permission map.
model User {
  id                 Int                  @id @default(autoincrement())
  name               String
  phone              String               @unique
  address            String?
  passwordHash       String
  role               String               @default("CUSTOMER")
  mfaSecret          String?
  mfaEnabled         Boolean              @default(false)
  createdAt          DateTime             @default(now())
  holds              Hold[]
  pharmacy           Pharmacy?
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  authorizationCodes AuthorizationCode[]
  oauthRefreshTokens OAuthRefreshToken[]
}

// A 30-minute reservation against one stock row.
model Hold {
  id          Int       @id @default(autoincrement())
  userId      Int
  stockItemId Int
  quantity    Int
  status      String    @default("ACTIVE")
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])
}

// Rotating refresh tokens for first-party sessions. Only the SHA-256 hash is
// stored; the raw token lives in an HttpOnly cookie. familyId groups a rotation
// chain so a replayed token can revoke the whole family.
model RefreshToken {
  id             Int       @id @default(autoincrement())
  userId         Int
  tokenHash      String    @unique
  familyId       String
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedByHash String?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
}

// Domain events persisted by the audit listener (EventEmitter).
model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  action    String
  entity    String
  entityId  String?
  metadata  String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([action])
}

// A partner application registered by an administrator for the OAuth/OIDC
// authorization server. Secrets are stored hashed.
model OAuthClient {
  id               Int                 @id @default(autoincrement())
  name             String
  clientId         String              @unique
  clientSecretHash String
  redirectUris     String
  scopes           String
  createdAt        DateTime            @default(now())
  codes            AuthorizationCode[]
  refreshTokens    OAuthRefreshToken[]
}

// A short-lived authorization code for the authorization-code + PKCE flow.
model AuthorizationCode {
  id                  Int         @id @default(autoincrement())
  codeHash            String      @unique
  clientId            Int
  userId              Int
  scopes              String
  redirectUri         String
  codeChallenge       String?
  codeChallengeMethod String?
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime    @default(now())
  client              OAuthClient @relation(fields: [clientId], references: [id])
  user                User        @relation(fields: [userId], references: [id])

  @@index([clientId])
}

// A rotating refresh token issued to an OAuth client.
model OAuthRefreshToken {
  id        Int         @id @default(autoincrement())
  tokenHash String      @unique
  clientId  Int
  userId    Int
  scopes    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime    @default(now())
  client    OAuthClient @relation(fields: [clientId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@index([clientId])
}
