# Copy to .env and fill in your own values. Never commit .env.

# PostgreSQL connection used by Prisma
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/velora?schema=public"

# Port the API listens on (optional, defaults to 3000)
PORT=3000

# development or production (optional, defaults to development)
NODE_ENV=development
