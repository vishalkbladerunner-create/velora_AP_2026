# Copy to .env and fill in your own values. Never commit .env.

# PostgreSQL connection used by Prisma
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/velora?schema=public"

# Secret used to sign access and consent JWTs (required, 32+ characters)
JWT_SECRET="replace-with-a-long-random-string"

# Token lifetimes (optional)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# OAuth/OIDC issuer used for discovery and ID tokens (optional)
OAUTH_ISSUER=http://localhost:3000

# Port the API listens on (optional, defaults to 3000)
PORT=3000

# Port for the raw HTTP metrics server (optional, defaults to 9464)
METRICS_PORT=9464

# Development auto-verifies a newly registered pharmacy (set false to require admin approval)
AUTO_VERIFY_PHARMACIES=true

# development or production (optional, defaults to development)
NODE_ENV=development
